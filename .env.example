# Copy this file to .env, then replace all placeholder values locally.
# .env is ignored by Git so production credentials cannot be committed.

ANTHROPIC_API_KEY=
H9N_EXTRACTION_MODEL=claude-sonnet-4-5-20250929

# The RAG code calls OpenRouter through the OpenAI-compatible Python SDK.
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
H9N_RAG_EMBEDDING_MODEL=openai/text-embedding-3-small
H9N_RAG_EMBEDDING_DIMENSIONS=1536
H9N_RAG_OPENROUTER_REFERER=http://localhost:8000
H9N_RAG_OPENROUTER_TITLE=H9N RAG (local development)

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-server-only-service-role-key
H9N_RAG_BUCKET=h9n-deal-packages

H9N_RAG_INTERNAL_API_KEY=replace-with-a-long-random-internal-api-key

H9N_RAG_CHUNK_SIZE=1200
H9N_RAG_CHUNK_OVERLAP=200
H9N_RAG_MAX_UPLOAD_BYTES=26214400
H9N_RAG_DEFAULT_MATCH_COUNT=6
