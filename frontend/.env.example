# Copy to .env.local and fill in. Every NEXT_PUBLIC_ value is built into the
# browser bundle, so only put values here that are safe for anyone to see.

# Supabase project URL and its publishable (anon) key, from Project Settings ->
# API Keys. Never put the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key

# Where the H9N FastAPI backend is running.
NEXT_PUBLIC_H9N_API_URL=http://localhost:8000
